{
  "expo": {
    "name": "belma - yapay mevzular hukuk asistanı",
    "description": "belma - yapay mevzular hukuk asistanı",
    "slug": "belma-hukuk",
    "owner": "kemalsutcus-team",
    "version": "1.0.0",
    "scheme": "belma",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yapaymevzular.belma",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSMicrophoneUsageDescription": "Belma ile sesli görüşebilmeniz için mikrofon erişimi gerekir.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Belma’ya inceletmek istediğiniz belgeyi fotoğraflamak için kamera erişimi gerekir.",
        "NSPhotoLibraryUsageDescription": "Belma’ya inceletmek istediğiniz belge ve görselleri seçebilmeniz için fotoğraf erişimi gerekir.",
        "NSSpeechRecognitionUsageDescription": "Belma’ya söylediğiniz ifadeleri yazıya dönüştürebilmek için konuşma tanıma erişimi gerekir."
      }
    },
    "android": {
      "package": "com.yapaymevzular.belma",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 170,
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "976cd0de-2e47-4383-97c4-8a3a9b5e8bff"
      }
    }
  }
}
