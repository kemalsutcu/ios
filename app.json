{
  "expo": {
    "name": "Yapay Mevzular",
    "slug": "yapay-mevzular",
    "owner": "kemalsutcus-team",
    "version": "1.0.0",
    "scheme": "yapaymevzular",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yapaymevzular.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSMicrophoneUsageDescription": "Ajanlarla sesli görüşebilmeniz için mikrofon erişimi gerekir.",
        "NSCameraUsageDescription": "Seçtiğiniz belge veya görselin fotoğrafını ajana gönderebilmeniz için kamera erişimi gerekir.",
        "NSPhotoLibraryUsageDescription": "Seçtiğiniz görselleri ajanla paylaşabilmeniz için fotoğraf erişimi gerekir.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yapaymevzular.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#183B35"
      },
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 170,
          "backgroundColor": "#F6F6F0"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e34f32e9-0aae-42cc-875e-91685b9fb62f"
      }
    }
  }
}
